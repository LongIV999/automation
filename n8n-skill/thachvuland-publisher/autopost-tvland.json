            "parameters": {
                "jsCode": "// Lấy toàn bộ item từ node trước\nlet items = $input.all();\n\n// Filter bỏ các folder (tránh lỗi 404 khi download)\nitems = items.filter(item => item.json.mimeType !== 'application/vnd.google-apps.folder');\n\n// Sắp xếp theo tên file (name), dạng tự nhiên (1.png < 2.png < 10.png)\nitems.sort((a, b) => {\n  const nameA = a.json.name ? a.json.name.toLowerCase() : '';\n  const nameB = b.json.name ? b.json.name.toLowerCase() : '';\n  return nameA.localeCompare(nameB, undefined, { numeric: true });\n});\n\nreturn items;\n"
            },
